<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Teams Bridge</string>
    <string name="never">never</string>
    <string name="cancel">Cancel</string>

    <!-- Main / Pair -->
    <string name="placeholder_banner">This build uses the placeholder google-services.json, so Firebase Cloud Messaging cannot deliver anything to it. Rebuild with the google-services.json of your Firebase project.</string>
    <string name="pair_title">Pair with tbd</string>
    <string name="pair_intro">On the computer that runs tbd, run <tt>tbd pair</tt>. Scan the QR code it shows, or type the code.</string>
    <string name="pair_scan">Scan QR code</string>
    <string name="pair_scan_prompt">Scan the QR code shown by tbd pair</string>
    <string name="pair_scan_not_tbd">That QR code is not a tbd pairing code.</string>
    <string name="pair_or_type">Or type the code:</string>
    <string name="pair_code_hint">Pairing code</string>
    <string name="pair_code_helper">26 characters: XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XX</string>
    <string name="pair_button">Pair</string>
    <string name="pair_invalid">That is not a valid pairing code. Check it and try again.</string>
    <string name="pair_store_failed">The secret could not be stored in the Android Keystore. Try again.</string>

    <!-- Waiting for the pair ping -->
    <string name="waiting_title">Waiting for the pair ping</string>
    <string name="waiting_subscribing">Subscribing to the pairing topic…</string>
    <string name="waiting_text">Subscribed. Let tbd pair finish: it sends a pair ping, and this screen moves on as soon as it arrives.</string>
    <string name="waiting_subscribe_failed">Could not subscribe to the pairing topic yet. Check the network and retry; the app also retries every hour.</string>
    <string name="waiting_placeholder">The code is stored, but this build has no real Firebase configuration, so it cannot subscribe.</string>
    <string name="waiting_retry">Retry</string>
    <string name="waiting_cancel">Cancel pairing</string>

    <!-- Status -->
    <string name="status_title">Status</string>
    <string name="status_paired">Paired: %1$s</string>
    <string name="status_subscribed">Topic subscription: active</string>
    <string name="status_not_subscribed">Topic subscription: pending (retried hourly)</string>
    <string name="status_heartbeat">Last heartbeat: %1$s</string>
    <string name="status_message">Last message: %1$s</string>
    <string name="status_alert">Last alert: %1$s</string>
    <string name="watchdog_unpaired">Watchdog: off.</string>
    <string name="watchdog_waiting">Watchdog: no heartbeat yet (%1$s since pairing).</string>
    <string name="watchdog_ok">Watchdog: OK.</string>
    <string name="watchdog_stale">Watchdog: nothing for %1$s.</string>
    <string name="watchdog_job_scheduled">Checks hourly.</string>
    <string name="watchdog_job_stopped">Hourly check is not scheduled.</string>
    <string name="watchdog_job_unknown">Hourly check: starting.</string>
    <string name="notifications_warning">Notifications are blocked: nothing will show. Tap to fix it below.</string>

