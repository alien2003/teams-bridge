    <string name="pairing_title">Pairing</string>
    <string name="unpair">Unpair</string>
    <string name="unpair_confirm_title">Unpair this phone?</string>
    <string name="unpair_confirm_text">The pairing secret is deleted from this phone and the topic is unsubscribed. Run tbd pair again to receive notifications.</string>

